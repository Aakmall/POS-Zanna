{
  "name": "pos-zanna-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "tsx --tsconfig tsconfig.tests.json --import ./scripts/test-assets.mjs --test scripts/demo-logic.test.mjs scripts/product-repository.test.ts scripts/cart-ui.test.tsx scripts/inventory.test.ts scripts/stock-ui.test.tsx scripts/checkout-domain.test.ts scripts/checkout-migration.test.ts scripts/checkout-service.test.ts scripts/checkout-ui.test.tsx",
    "test:checkout-ui": "tsx --tsconfig tsconfig.tests.json --import ./scripts/test-assets.mjs --test scripts/cart-ui.test.tsx scripts/checkout-ui.test.tsx",
    "test:checkout": "tsx --tsconfig tsconfig.tests.json --test scripts/checkout-domain.test.ts scripts/checkout-migration.test.ts scripts/checkout-service.test.ts",
    "test:inventory": "tsx --tsconfig tsconfig.tests.json --test scripts/inventory.test.ts",
    "test:unit": "tsx --tsconfig tsconfig.tests.json --test scripts/demo-logic.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
